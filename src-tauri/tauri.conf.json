{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TellerAssist",
  "version": "1.0.0",
  "identifier": "com.bank.tellerassist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "智晓通 - 对公业务可信智能填单工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 750,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
